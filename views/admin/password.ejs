<%- include('_top') %>
<div class="page-head"><div><h1>Change password</h1></div></div>
<section class="card">
  <form class="form" method="post" action="/admin/password" style="max-width:420px">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field"><label for="current">Current password</label><input id="current" name="current" type="password" autocomplete="current-password" required></div>
    <div class="field"><label for="password">New password</label><input id="password" name="password" type="password" autocomplete="new-password" minlength="8" required><div class="help">At least 8 characters.</div></div>
    <div class="field"><label for="confirm">Confirm new password</label><input id="confirm" name="confirm" type="password" autocomplete="new-password" minlength="8" required></div>
    <div class="form-actions"><button class="btn" type="submit">Change password</button></div>
  </form>
</section>
<%- include('_bottom') %>
