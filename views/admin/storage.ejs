<%- include('_top') %>
<div class="page-head">
  <div>
    <h1>Storage</h1>
    <p>All uploaded photos and PDFs are stored in the database, which is shared with the school app (sfsapp). Uploads are blocked once usage reaches <%= storagePcts.block %>% so the school app always has room.</p>
  </div>
</div>

<%- include('_storage-card', { storage: usage }) %>

<section class="card">
  <h2>What's using space on the website</h2>
  <div class="table-wrap" style="box-shadow:none">
    <table>
      <thead><tr><th>Section</th><th class="num">Files</th><th class="num">Uploaded size</th><th class="num">Stored size</th><th class="num">Saved by compression</th></tr></thead>
      <tbody>
        <% breakdown.categories.forEach((c) => { const saved = c.original > 0 ? Math.max(0, Math.round((1 - c.bytes / c.original) * 100)) : 0; %>
          <tr>
            <td><%= c.label %></td>
            <td class="num"><%= c.files %></td>
            <td class="num"><%= formatBytes(c.original) %></td>
            <td class="num"><b><%= formatBytes(c.bytes) %></b></td>
            <td class="num"><%= c.files ? saved + '%' : '—' %></td>
          </tr>
        <% }) %>
        <tr>
          <td>Unused files <span class="badge badge-muted">can be removed</span></td>
          <td class="num"><%= breakdown.orphans.files %></td>
          <td class="num">—</td>
          <td class="num"><b><%= formatBytes(breakdown.orphans.bytes) %></b></td>
          <td class="num">—</td>
        </tr>
      </tbody>
    </table>
  </div>
  <% if (breakdown.orphans.files) { %>
    <form method="post" action="/admin/storage/cleanup" data-confirm="Permanently delete <%= breakdown.orphans.files %> unused file(s)?" style="margin-top: var(--s-4)">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn btn-danger" type="submit"><%- icon('trash') %>Clean up unused files (<%= formatBytes(breakdown.orphans.bytes) %>)</button>
    </form>
  <% } %>
</section>

<section class="card">
  <h2>Largest files</h2>
  <% if (!breakdown.largest.length) { %>
    <p style="color: var(--ink-mute)">No files uploaded yet.</p>
  <% } else { %>
    <div class="table-wrap" style="box-shadow:none">
      <table>
        <thead><tr><th>File</th><th>Section</th><th>Uploaded</th><th class="num">Size</th></tr></thead>
        <tbody>
          <% breakdown.largest.forEach((m) => { %>
            <tr>
              <td><a href="/media/<%= m.id %>" target="_blank" rel="noopener"><%= m.original_name || (m.kind === 'pdf' ? 'Document.pdf' : 'Image') %></a></td>
              <td><%= m.category %></td>
              <td><%= fmtDate(m.created_at) %></td>
              <td class="num"><b><%= formatBytes(m.bytes) %></b></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <p style="margin: var(--s-3) 0 0; font-size:.85rem; color: var(--ink-mute)">To free space, delete items from their section (Gallery, Calendars, etc.). Their files are removed automatically.</p>
  <% } %>
</section>

<section class="card">
  <h2>Storage limit</h2>
  <p style="color: var(--ink-soft)">Set this to your Render database plan's storage size. Render doesn't report it automatically, so update it here if you upgrade the plan.</p>
  <form class="form" method="post" action="/admin/storage/limit" style="max-width: 420px">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field">
      <label for="limit_mb">Database storage limit (MB)</label>
      <input id="limit_mb" name="limit_mb" type="number" min="100" step="1" value="<%= limitMb %>" required>
      <div class="help">1 GB = 1024 MB. Warnings at <%= storagePcts.warn %>% and <%= storagePcts.critical %>%, uploads blocked at <%= storagePcts.block %>%.</div>
    </div>
    <div class="form-actions"><button class="btn" type="submit">Save limit</button></div>
  </form>
</section>
<%- include('_bottom') %>
